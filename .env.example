DATABASE_URL=postgresql://clutch:clutch@localhost:5432/clutch
REDIS_URL=redis://localhost:6379
SESSION_SECRET=change-me-in-production-use-32-chars-min
API_PORT=4000
API_HOST=0.0.0.0
CORS_ORIGIN=http://localhost:3000
NODE_ENV=development
EVALUATION_CONCURRENCY=2
# One-time admin bootstrap (CLI only): pnpm --filter @clutch/api bootstrap:admin
# Set these per-invocation; NEVER commit real credentials.
CLUTCH_ADMIN_HANDLE=sami
CLUTCH_ADMIN_PASSWORD=
